{
  "expo": {
    "name": "MyPi",
    "slug": "mypi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "mypi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mypi.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "dev.mypi.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MyPi to access your camera to scan server pairing QR codes."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
